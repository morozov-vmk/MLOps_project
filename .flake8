cat > .flake8 << 'EOF'
[flake8]
max-line-length = 90
extend-ignore = D100, D101, D102, D103, D104, D105, D107, D400, D401, D205, E402
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    .github
per-file-ignores =
    __init__.py:D100,D101,D102,D103,D104
    tests/__init__.py:D100,D101,D102,D103,D104
    tests/*:D100,D101,D102,D103,D104,D105,D107,D400,D401,D205
    src/__init__.py:D100,D101,D102,D103,D104
EOF
